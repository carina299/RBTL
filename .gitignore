# ── secrets & private state — NEVER commit ──────────────────────────────
# Filled env files (the templates *.env.example are the only ones tracked)
relay.env
.env
**/.env
!**/.env.example
# VAPID / TLS private keys
*.pem
*.key
# Runtime data: the conversation DB and uploaded attachments are private
relay.db
relay.db-*
uploads/
inbox/
last_in_id
db_backups/
*.dump
# Claude / MCP local config — .mcp.json holds real DB credentials/absolute
# paths once filled in; .mcp.json.example is the tracked template instead.
.mcp.json
# Claude Code's own per-machine state under .claude/ — none of this is
# project config meant to be shared between contributors.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
.claude/routines/.state/
.claude/worktrees/
.claude/checkpoints/
.claude/mailbox/
.claude/agent-registry.json
.claude/agent-memory-local
.claude/first-run
.claude/assistant-daemon-state.json

# ── build / deps ────────────────────────────────────────────────────────
node_modules/
bun.lock
bun.lockb
__pycache__/
*.pyc
venv/
.venv/

# ── editor / OS noise ───────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.bak
*.bak-*
.idea/
.vscode/
