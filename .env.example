# ============================================================
#  docker-compose env — used by BOTH local dev and a VPS deploy
#  cp .env.example .env && chmod 600 .env
# ============================================================

# ---- Postgres (compose wires RELAY_DATABASE_URL from these automatically) ----
POSTGRES_USER=rbtl
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=rbtl

# ---- everything else the backend needs (same variables as backend/.env.example,
#      loaded into the `backend` container via env_file) ----
RELAY_SECRET=
RELAY_AI_NAME=Claude
RELAY_HUMAN_NAME=Your Name

# Empty here: no nginx sits in front to strip a prefix in local docker-compose.
# On a VPS running docker-compose behind nginx, set this to /relay instead (and
# make sure nginx's location block matches — see backend/nginx-companion.conf.example).
RELAY_PUBLIC_PREFIX=

RELAY_APP_PATH=/chat/
# Local: the web container serves the PWA on :8080. VPS: put your https domain here.
RELAY_ALLOW_ORIGINS=http://localhost:8080

RELAY_MAX_UPLOAD_BYTES=10485760
RELAY_VOICE_MAX_BYTES=8388608

# ---- optional (leave blank to disable) ----
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ZH=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- long-term memory (leave MEMORY_EXTRACTION_ENABLED=false to keep the
#      whole feature off; everything else only matters once it's on) ----
MEMORY_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_EVERY_N=20
# LLM that turns dialogue into memory candidates (extraction_graph).
# LLM_PROVIDER=anthropic|openai|gemini|openai_compatible — see
# backend/.env.example for the full set of per-provider vars.
ANTHROPIC_API_KEY=
# Embeddings for dedup/similarity. EMBEDDING_PROVIDER=openai|gemini|local|
# local_hash — 'openai'/'gemini' need a key below; leave both blank (or set
# EMBEDDING_PROVIDER=local_hash) to use the built-in deterministic dev/test
# provider instead — fine for trying the pipeline out, not for real retrieval
# quality. See backend/.env.example for the full set of per-provider vars.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- album object storage (docker-compose's `minio` service by default;
#      STORAGE_BACKEND=local falls back to the backend's own uploads/ dir
#      instead, no MinIO needed) ----
STORAGE_BACKEND=minio
MINIO_ACCESS_KEY=rbtl_minio_admin
MINIO_SECRET_KEY=change-me-to-something-random
# What a browser/phone can actually reach to fetch a presigned image URL —
# localhost:9000 for local dev; your real public S3/R2/MinIO domain on a
# VPS/cloud deploy. (MINIO_ENDPOINT itself is set in docker-compose.yml to the
# internal "minio:9000" — only override that if you're not using compose's
# bundled MinIO at all.)
MINIO_PUBLIC_ENDPOINT=localhost:9000
