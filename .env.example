# ============================================================
#  docker-compose env — used by BOTH local dev and a VPS deploy
#  cp .env.example .env && chmod 600 .env
# ============================================================

# ---- Postgres (compose wires RELAY_DATABASE_URL from these automatically) ----
POSTGRES_USER=rbtl
POSTGRES_PASSWORD=change-me-to-something-random
POSTGRES_DB=rbtl

# ---- everything else the backend needs (same variables as backend/.env.example,
#      loaded into the `backend` container via env_file) ----
RELAY_SECRET=
RELAY_AI_NAME=Claude
RELAY_HUMAN_NAME=Your Name

# Empty here: no nginx sits in front to strip a prefix in local docker-compose.
# On a VPS running docker-compose behind nginx, set this to /relay instead (and
# make sure nginx's location block matches — see backend/nginx-companion.conf.example).
RELAY_PUBLIC_PREFIX=

RELAY_APP_PATH=/chat/
# Local: the web container serves frontend/ on :8080. VPS: put your https domain here.
RELAY_ALLOW_ORIGINS=http://localhost:8080

RELAY_MAX_UPLOAD_BYTES=10485760
RELAY_VOICE_MAX_BYTES=8388608

# ---- optional (leave blank to disable) ----
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_VOICE_ZH=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- long-term memory (leave MEMORY_EXTRACTION_ENABLED=false to keep the
#      whole feature off; everything else only matters once it's on) ----
MEMORY_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_EVERY_N=20
# LLM that turns dialogue into memory candidates (extraction_graph).
# LLM_PROVIDER=anthropic|openai|gemini|openai_compatible — see
# backend/.env.example for the full set of per-provider vars.
ANTHROPIC_API_KEY=
# Embeddings for dedup/similarity. EMBEDDING_PROVIDER=openai|gemini|local|
# local_hash — 'openai'/'gemini' need a key below; leave both blank (or set
# EMBEDDING_PROVIDER=local_hash) to use the built-in deterministic dev/test
# provider instead — fine for trying the pipeline out, not for real retrieval
# quality. See backend/.env.example for the full set of per-provider vars.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- album object storage (docker-compose's `minio` service by default;
#      STORAGE_BACKEND=local falls back to the backend's own uploads/ dir
#      instead, no MinIO needed) ----
STORAGE_BACKEND=minio
MINIO_ACCESS_KEY=rbtl_minio_admin
MINIO_SECRET_KEY=change-me-to-something-random
# What a browser/phone can actually reach to fetch a presigned image URL —
# localhost:9000 for local dev; your real public S3/R2/MinIO domain on a
# VPS/cloud deploy. (MINIO_ENDPOINT itself is set in docker-compose.yml to the
# internal "minio:9000" — only override that if you're not using compose's
# bundled MinIO at all.)
MINIO_PUBLIC_ENDPOINT=localhost:9000

# ---- proactive outreach ----
# Off by default. Turning it on lets the AI start conversations; everything
# below is about making sure that stays welcome rather than relentless.
PROACTIVE_ENABLED=false
# Collapses every window below to seconds so one full pass takes under a
# minute. For tuning the wording — leave off otherwise.
PROACTIVE_DEBUG_FAST=false

# Three independent gates; all of them have to pass.
#   hard block  - never interrupt an exchange that is still going
#   quiet window - how long she has to have been quiet (the SILENCE knobs below)
#   cooldown    - minimum gap between one outreach and the next, shared by
#                 every kind, so adding a new kind cannot multiply interruptions
PROACTIVE_HARD_BLOCK_MINUTES=10
PROACTIVE_COOLDOWN_MINUTES=60
# Ceiling on the whole day, on top of the pacing above.
PROACTIVE_DAILY_CAP=2

# Whether the small hours count toward how long she has been quiet. Leaving
# this false means a night of sleep is not mistaken for being ignored —
# otherwise every morning opens "having not spoken for ten hours" and outreach
# turns into an alarm clock.
PROACTIVE_NIGHT_COUNTS_AS_SILENCE=false

# What the AI is told when woken. {local_time} and {quiet_minutes} get filled
# in. Whatever you write, keep saying that staying quiet is a valid answer:
# without that, being woken reads as an instruction to produce something and
# every tick becomes a message.
PROACTIVE_NUDGE_TEMPLATE=

# Where the worker reaches the relay to deliver a nudge. The default is the
# compose service name; only change it if the two run somewhere else.
RELAY_INTERNAL_URL=http://backend:3011

# ---- proactive outreach pacing ----
# How often the above gets reconsidered.
# The hours are LOCAL ones: Celery runs in UTC, so without a zone here a
# "daytime" window lands in the wrong part of the day. Set it to where you
# actually live (e.g. America/New_York, Asia/Shanghai).
PROACTIVE_TIMEZONE=UTC
# Daytime window. start > end wraps past midnight (22 -> 6); start == end
# means "always daytime".
PROACTIVE_DAY_START_HOUR=9
PROACTIVE_DAY_END_HOUR=23
# How often to reconsider reaching out.
PROACTIVE_DAY_CHECK_MINUTES=10
PROACTIVE_NIGHT_CHECK_MINUTES=120
# How long you have to have been quiet before it is even on the table.
PROACTIVE_DAY_SILENCE_MINUTES=60
PROACTIVE_NIGHT_SILENCE_MINUTES=120
