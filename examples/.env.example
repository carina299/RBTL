# ============================================================
#  bridge_any_llm.py — configuration template
#  cp .env.example .env  and fill it in. Do NOT commit .env to git.
# ============================================================

# ---- relay (your own backend) --------------------------------
# Domain + nginx's /relay prefix; RELAY_SECRET must match the backend's
# relay.env exactly.
RELAY_URL=https://your-domain.example/relay
RELAY_SECRET=

# ---- your model (pick any "OpenAI-compatible" endpoint) ------------------------
# Just fill in BASE / KEY / MODEL. Common providers:
#   OpenAI    BASE=https://api.openai.com/v1                              MODEL=gpt-4o
#   DeepSeek  BASE=https://api.deepseek.com/v1                            MODEL=deepseek-chat
#   Qwen      BASE=https://dashscope.aliyuncs.com/compatible-mode/v1       MODEL=qwen-plus
#   Zhipu GLM BASE=https://open.bigmodel.cn/api/paas/v4                   MODEL=glm-4.6
#   Kimi      BASE=https://api.moonshot.cn/v1                             MODEL=kimi-k2
#   Gemini    BASE=https://generativelanguage.googleapis.com/v1beta/openai MODEL=gemini-2.5-pro
#   local vLLM BASE=http://127.0.0.1:8000/v1                              MODEL=<your-local-model>
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# ---- optional: fallback model chain (tried in order on 401/403/429/5xx) -------
# LLM_API_BASE_2=
# LLM_API_KEY_2=
# LLM_MODEL_2=

# ---- persona (system prompt) ----------------------------------
# Either set PERSONA directly, or point at a file with PERSONA_FILE (better for
# long personas).
# PERSONA=You are the user's AI companion. Speak naturally, briefly, and warmly, like texting on a phone.
# PERSONA_FILE=./persona.md

# ---- tuning (all have defaults, can be left unset) ------------------------------
# HISTORY_N=12            # recent messages fed to the model (too few looks forgetful)
# LLM_TEMPERATURE=0.7
# LLM_TIMEOUT=120         # per-request model timeout (seconds)
# RELAY_CHAT_ID=me        # single-user channel is always "me", rarely needs changing
# BRIDGE_STATE_DIR=~/.companion-bridge   # where the reconnect cursor is stored

# ============================================================
#  api_loop.py — optional: a long-running server-side API body
#  After switching the relay's /app/brain to "loop", PWA messages are
#  forwarded to this service.
# ============================================================

# Port the loop service listens on; the relay points at it via RELAY_LOOP_INGEST_URL.
# LOOP_PORT=3020

# api_loop reads relay.db directly for recent same-window context.
# When deployed to a server this is usually /root/companion-relay/relay.db
# RELAY_DB=/root/companion-relay/relay.db

# api_loop POSTs its replies to the relay's /channel/out. If it runs on the same
# host and port as the relay, keep the local address.
# RELAY_URL=http://127.0.0.1:3011
# RELAY_SECRET=same as backend/relay.env's RELAY_SECRET

# persona: set PERSONA directly, or use a long file.
# PERSONA=You are the user's private AI companion. Reply naturally and warmly.
# PERSONA_FILE=/root/companion-loop/persona.md

# Whether loop output uses reply_delta streaming drafts; 0/false/no = wait for the
# full sentence before sending the final reply.
# LOOP_STREAM=1

# Optional: runtime config file storing the session list, history_n, and the
# model chain edited from the frontend.
# LOOP_CONFIG=/root/companion-loop/api_loop.config.json
