# ============================================================
#  companion relay — environment template
#  Copy to  relay.env  and fill in. NEVER commit the filled file.
#    cp .env.example relay.env && chmod 600 relay.env
# ============================================================

# ---- REQUIRED: shared auth secret --------------------------------
# ONE secret guards every endpoint. The PWA and the local channel plugin
# both send it as a Bearer token. Generate a fresh random one (do NOT reuse
# anyone else's):
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RELAY_SECRET=

# ---- identity (your names) ---------------------------------------
RELAY_AI_NAME=Claude          # <- your AI companion's display name (push title, narration)
RELAY_HUMAN_NAME=Your Name    # <- how the AI is told about you in voice/call narration ("… started a voice call")

# ---- database (Postgres — required; see ../docker-compose.yml) ----
# postgresql+psycopg://<user>:<password>@<host>:5432/<db>
# docker-compose sets this itself (from POSTGRES_* in the root .env) — only set
# it here if you're running the backend OUTSIDE docker-compose (bare venv on a
# VPS, or Render's env var UI, which fills this from its own managed database).
RELAY_DATABASE_URL=postgresql+psycopg://rbtl:rbtl_password@localhost:5432/rbtl

# ---- paths / network ---------------------------------------------
RELAY_PORT=3011
RELAY_DB=/root/companion-relay/relay.db
RELAY_UPLOAD_DIR=/root/companion-relay/uploads
# Public URL prefix upload/attachment links are built under: "<prefix>/uploads/<file>".
#   VPS behind nginx  -> "/relay"  (nginx strips it and reverse-proxies to this app)
#   docker-compose (local/VPS) or Render -> ""  (empty — nothing strips a prefix,
#     so the app must be reachable at its own root; the frontend's RELAY_URL /
#     API_BASE handles pointing at the right origin instead, see web/index.html)
RELAY_PUBLIC_PREFIX=/relay
# Where a push-notification tap should open the PWA (your nginx static prefix).
RELAY_APP_PATH=/chat/
# CORS allow-list (comma separated). Put every real frontend origin here —
# e.g. VPS: your https domain; split-origin cloud: your Vercel URL(s).
RELAY_ALLOW_ORIGINS=https://your-domain.example,http://localhost:8080

# ---- optional API loop routing -----------------------------------
# Default "desktop" means PWA messages go to the Claude Code channel plugin.
# POST /app/brain {"target":"loop"} writes RELAY_BRAIN_FILE and sends new
# messages to RELAY_LOOP_INGEST_URL instead.
RELAY_BRAIN_FILE=/root/companion-relay/brain_target
RELAY_LOOP_INGEST_URL=http://127.0.0.1:3020/loop/ingest

# ---- upload limits -----------------------------------------------
RELAY_MAX_UPLOAD_BYTES=10485760   # 10 MB (keep <= nginx client_max_body_size)
RELAY_VOICE_MAX_BYTES=8388608     # 8 MB
# Optional local ASR hook: a command taking  <audio_path> <mime>  that prints a transcript.
# Leave blank to just deliver voice as an audio attachment.
RELAY_VOICE_TRANSCRIBE_CMD=

# ---- MiniMax TTS (OPTIONAL — leave keys blank to disable spoken replies) ----
# Get your own keys at the MiniMax console and create a voice id.
MINIMAX_API_BASE=https://api.minimaxi.com
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_MODEL=speech-02-hd
MINIMAX_VOICE_ZH=
MINIMAX_TTS_TIMEOUT=30

# ---- Web Push / VAPID (OPTIONAL — leave blank to disable lock-screen push) ----
# Generate your OWN key pair (see DEPLOY.md, "Web Push"). Never reuse another's.
#   VAPID_PUBLIC_KEY  = the base64url applicationServerKey the browser subscribes with
#   VAPID_PRIVATE_PEM = path to private_key.pem (or the inline PEM text)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM=/root/companion-relay/private_key.pem
VAPID_SUBJECT=mailto:you@your-domain.example

# ---- presence tuning (seconds) -----------------------------------
RELAY_PRESENCE_ONLINE_SEC=180
RELAY_PRESENCE_RECENT_SEC=1800

# ---- long-term memory (Part 2: Agentic RAG / LangGraph — OPTIONAL, off by
#      default) ------------------------------------------------------------
# Redis broker for the Celery-triggered extraction_graph. docker-compose sets
# this itself (see ../docker-compose.yml's `redis` service) — only set it here
# outside docker-compose.
REDIS_URL=redis://localhost:6379/0
# Master switch: every MEMORY_EXTRACTION_EVERY_N inbound human messages,
# app.py enqueues one extraction_graph run. Off by default so a fresh clone
# with no API keys configured still boots cleanly.
MEMORY_EXTRACTION_ENABLED=false
MEMORY_EXTRACTION_EVERY_N=20
# LLM that turns a chunk of dialogue into candidate memories (extract_candidates
# node). Called directly over HTTP — no SDK needed, just an API key.
# LLM_PROVIDER=anthropic|openai|gemini|openai_compatible; defaults to whichever
# of ANTHROPIC_API_KEY/OPENAI_API_KEY/GEMINI_API_KEY (in that order) is set,
# else 'openai_compatible' if OPENAI_COMPATIBLE_API_BASE is set.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
MEMORY_EXTRACTION_MODEL=claude-haiku-4-5-20251001
MEMORY_EXTRACTION_OPENAI_MODEL=gpt-4o-mini
MEMORY_EXTRACTION_GEMINI_MODEL=gemini-2.5-flash
# Any self-hosted/third-party endpoint speaking OpenAI's chat-completions wire
# format (Ollama, vLLM, OpenRouter, ...) — separate from OPENAI_API_KEY below.
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_API_BASE=
OPENAI_COMPATIBLE_MODEL=

# Embeddings for dedup/similarity search.
# EMBEDDING_PROVIDER=openai|gemini|local|local_hash; defaults to whichever of
# OPENAI_API_KEY/GEMINI_API_KEY is set, else 'local_hash' (a built-in
# deterministic dev/test provider with no external call and no real semantic
# meaning — fine to try the pipeline, not for real use). 'local' runs a real
# local model (BGE/Qwen/MiniLM/...) via sentence-transformers — needs that
# package installed and a model whose output dimension matches EMBEDDING_DIM.
# OPENAI_API_KEY/GEMINI_API_KEY below are shared with the LLM section above —
# set once, used by whichever of LLM_PROVIDER/EMBEDDING_PROVIDER selects it.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ---- album object storage (OPTIONAL, defaults to writing into
#      RELAY_UPLOAD_DIR like chat uploads already do) ----------------------
# 'local' needs nothing else below. 'minio' needs a MinIO (or real S3/R2)
# bucket — docker-compose provides one itself (see ../docker-compose.yml's
# `minio` service); outside compose, point these at your own.
STORAGE_BACKEND=local
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=rbtl-album
MINIO_SECURE=false
# What a browser/phone can actually reach for a presigned image URL — only
# needed if it differs from MINIO_ENDPOINT (e.g. compose's internal
# "minio:9000" vs. "localhost:9000" from the browser's point of view).
MINIO_PUBLIC_ENDPOINT=
